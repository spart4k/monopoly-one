# server/.env
NODE_ENV=development

# 🔹 Вариант А: Если БД в Докере (рекомендую)
DATABASE_URL=postgresql://monopoly:devpass@127.0.0.1:5432/monopoly

# 🔹 Вариант Б: Если БД локально (и пароль содержит спецсимволы — закодируй их!)
# Пример: пароль "p@ss!word" → "p%40ss%21word"
# DATABASE_URL=postgresql://monopoly:p%40ss%21word@127.0.0.1:5432/monopoly

REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-secret-change-in-prod